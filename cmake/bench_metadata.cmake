# Write only when provenance changes, so an unchanged build does not recompile.
set(commit "unknown")
set(state "unknown")
find_program(git_program git)
if(git_program)
    execute_process(COMMAND "${git_program}" -C "${CHUNKDB_SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result ERROR_QUIET)
    if(result EQUAL 0)
        set(commit "${head}")
        execute_process(COMMAND "${git_program}" -C "${CHUNKDB_SOURCE_DIR}" status --porcelain
            OUTPUT_VARIABLE changes RESULT_VARIABLE status_result ERROR_QUIET)
        if(status_result EQUAL 0)
            if(changes STREQUAL "")
                set(state "clean")
            else()
                set(state "modified")
            endif()
        endif()
    endif()
endif()
set(fingerprints "")
foreach(source CMakeLists.txt bench/server_bench_lib.cpp bench/chunkdb_server_bench.cpp include/chunkdb/server_bench.hpp cmake/bench_metadata.cmake)
    file(SHA256 "${CHUNKDB_SOURCE_DIR}/${source}" hash)
    string(APPEND fingerprints "${source}:${hash}\n")
endforeach()
string(SHA256 source_hash "${fingerprints}")
set(content "#pragma once\n#define CHUNKDB_BENCH_SOURCE_COMMIT \"${commit}\"\n#define CHUNKDB_BENCH_SOURCE_STATE \"${state}\"\n#define CHUNKDB_BENCH_SOURCE_SHA256 \"${source_hash}\"\n")
file(MAKE_DIRECTORY "${CHUNKDB_OUTPUT_DIR}")
set(output "${CHUNKDB_OUTPUT_DIR}/bench_build.hpp")
set(previous "")
if(EXISTS "${output}")
    file(READ "${output}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${output}" "${content}")
endif()
